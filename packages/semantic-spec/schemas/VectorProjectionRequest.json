{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VectorProjectionRequest",
  "description": "Request for semantic vector similarity search",
  "type": "object",
  "properties": {
    "embeddings": {
      "type": "array",
      "description": "Pre-computed embedding vector",
      "items": {
        "type": "number"
      }
    },
    "text": {
      "type": "string",
      "description": "Text to embed and search for (alternative to embeddings)"
    },
    "threshold": {
      "type": "number",
      "description": "Minimum cosine similarity threshold (0.0-1.0)",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.85
    },
    "top_k": {
      "type": "integer",
      "description": "Number of top results to return",
      "minimum": 1,
      "default": 10
    }
  },
  "oneOf": [
    { "required": ["embeddings"] },
    { "required": ["text"] }
  ],
  "additionalProperties": false
}
