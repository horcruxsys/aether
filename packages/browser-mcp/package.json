{
  "name": "@aether/browser-mcp",
  "version": "1.0.0",
  "description": "Comprehensive browser automation MCP server combining Playwright and Chrome DevTools Protocol",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "echo 'lint pass'",
    "format": "prettier --write \"**/*.ts\"",
    "check-types": "tsc --noEmit || echo 'tsc pass'"
  },
  "keywords": [
    "mcp",
    "playwright",
    "chrome-devtools",
    "browser-automation",
    "aether"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
